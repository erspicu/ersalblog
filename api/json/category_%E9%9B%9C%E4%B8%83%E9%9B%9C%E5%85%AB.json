\u95dc\u65bc\u672cBlog\u767c\u5c55","post_index":"20240504202440.html"}]},"tags":{"\u5176\u4ed6":3,"\u624b\u6a5f\u651d\u5f71":8,"\u5c0f\u7c7315ultra":3,"\u4f5c\u54c1":7,"\u5c0f\u7c7313ultra":4,"\u786c\u9ad4":3,"\u958b\u7bb1":1,"LUMIXS9":1,"LUMIXS28-200mm":1},"posts":[{"post_category":["\u958b\u7bb1\u5206\u4eab","\u96dc\u4e03\u96dc\u516b"],"post_tags":["\u786c\u9ad4"],"post_time":"2024-05-05 19:55:30","post_title":"Nikon COOLPIX P1000\u5fc3\u5f97","post_content":"<p>2024\u5e744\u670811\u65e5\u8cfc\u8cb7,\u9019\u53f0\u76f8\u6a5f\u5176\u5be6\u5f88\u4e45\u524d\u5c31\u60f3\u8cb7\u4e86,\u7121\u5948\u7576\u6642\u4e0a\u5e02\u6642\u624d\u525b\u8cb7P900\u4e0d\u4e45,\u52a0\u4e0a\u525b\u4e0a\u5e02\u6bd4\u8f03\u8cb4,\u52302024\u5e74\u5df2\u7d93\u505c\u7522,\u5e02\u9762\u4e0a\u80fd\u8cb7\u5230\u7684\u90fd\u662f\u820a\u8ca8\u4e86,\u60f3\u8aaa\u8d81\u9084\u6709\u5eab\u5b58\u8cb7\u4e00\u53f0\u4e0b\u4f86,\u96d6\u7136\u4e5f\u4e0d\u78ba\u5b9a\u6703\u4e0d\u6703\u7d93\u5e38\u4f7f\u7528\u5230,\u50cfP900\u591a\u6578\u4e5f\u662f\u64fa\u8457\u591a..\u4f46\u4ee5\u786c\u9ad4\u6536\u85cf\u4f86\u8aaa,\u6211\u89ba\u5f97\u8cb7\u4e86\u6536\u85cf\u7576\u73a9\u5177\u4e5f\u5f88\u503c\u5f97,\r\n    \u56e0\u70ba\u9019\u53f0\u771f\u7684\u662f\u5e02\u9762\u4e0a\u80fd\u8cb7\u5230\u6700\u9577\u7126\u7684\u6578\u4f4d\u76f8\u6a5f,\u7db2\u8def\u4e0a\u5f88\u591a\u62ff\u4f86\u62cd\u651d\u6708\u4eae.\u571f\u661f.\u706b\u661f.\u6728\u661f.\u91d1\u661f,\u7576\u6210\u671b\u9060\u93e1\u7528,\u4e0b\u9762\u662f\u6211\u62cd\u7684\u6708\u4eae(\u9304\u5f71,\u95dc\u9589\u5149\u8b8a)<\/p>\r\n\r\n<div style=\"text-align: center ;\">\r\n    <iframe src=\"https:\/\/www.youtube.com\/embed\/g45oUMNA6b4?si=dHNluasPP59yf5yp\" title=\"YouTube video player\"\r\n        style=\"border-style: none;\"\r\n        allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\r\n        referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen><\/iframe>\r\n<\/div>\r\n\r\n\r\n<p>\u62cd\u651d\u9ce5\u985e\u751f\u614b\u4e5f\u5f88\u9069\u5408,\u96d6\u7136\u6a5f\u8eab\u6eff\u91cd\u7684,\u4f46\u771f\u7684\u662f\u9019\u500b\u50f9\u4f4d.\u9ad4\u7a4d.\u91cd\u91cf\u4e0b\u80fd\u8cb7\u5230\u6700\u9577\u7684\u6578\u4f4d\u76f8\u6a5f\u4e86,\u5149\u8b8a24\u52303000MM.<\/p>\r\n\r\n<p>\u4f7f\u7528\u9019\u53f0\u5927\u5bb6\u6700\u95dc\u5fc3\u7684\u5c31\u662f\u5728\u6700\u5927\u5149\u8b8a3000MM\u60c5\u6cc1\u4e0b,\u5b83\u7684\u756b\u8cea\u5982\u4f55?\u90a3\u6211\u5c31\u76f4\u63a5\u8aaa\u7d50\u8ad6,\u5b83\u672c\u8eab\u5149\u5b78\u756b\u8cea\u5373\u4f7f\u57283000MM\u90fd\u9060\u5728\u582a\u7528\u756b\u8cea\u4e4b\u4e0a,\u4e0d\u904e\u52303000MM\u7684\u78ba\u7565\u70ba\u9b06\u6563,\u4e0d\u904e\u4e0d\u662f\u4ec0\u9ebc\u554f\u984c,\u6700\u5927\u7684\u554f\u984c\u662f\u5ba2\u89c0\u74b0\u5883\u689d\u4ef6\u4e0b\u5e38\u5e38\u8b93\u4eba\u96e3\u4ee5\u767c\u63ee\u756b\u8cea,\r\n    \u5982\u679c\u80fd\u5920\u6392\u9664\u7a7a\u6c23\u973e\u5bb3.\u71b1\u64fe.\u8173\u67b6\u4e0d\u7a69.\u98a8\u5439\u6643\u52d5\u4e14\u5149\u6e90\u9806\u5149\u67d4\u548c\u5149\u7dda\u5145\u8db3.\u4f4eISO.\u6416\u63a7\u5feb\u9580(\u5efa\u8b70\u8cb7\u5b83\u7684\u85cd\u82bd\u9059\u63a7\u5feb\u9580),\u532f\u96c6\u9019\u4e9b\u689d\u4ef6\u4e0b\u62cd\u51fa\u4f86\u7b97\u9084\u6eff\u4e0d\u932f\u7684,\u5982\u679c\u4f60\u8981\u767c\u63ee\u5b83\u7684\u756b\u8cea\u5c31\u5148\u8cb7\u4e00\u500b\u7a69\u56fa\u8173\u67b6\u5427,\u4f46\u6211\u89ba\u5f97\u53ef\u4ee5\u52303000MM\u7a69\u5b9a\u7684\u8173\u67b6\u50f9\u4f4d\u8ddf\u9ad4\u7a4d\u91cd\u91cf\u7b49\u7b49\u60f3\u5fc5\u662f\u4e00\u500b\u4e0d\u5c0f\u8ca0\u64d4\u5c31\u662f....\r\n<\/p>\r\n\r\n<p>\u53e6\u5916\u62cd\u651d\u76ee\u524d\u6211\u89ba\u5f97\u7684\u6700\u597d\u7684\u62cd\u651d\u65b9\u5f0f,\u5927\u6982\u662f\u55ae\u6b21\u5b9a\u9ede\u5c0d\u7126,\u4e0a\u8173\u67b6.\u95dc\u9589\u9632\u624b\u9707(\u96d6\u7136\u4e0d\u78ba\u5b9a\u6709\u6c92\u6709\u5f71\u97ff\u5728),\u8173\u67b6\u4e0d\u5920\u7a69\u5c31\u7b49\u98a8\u505c\u4e86\u756b\u9762\u6643\u52d5\u5b8c\u5168\u505c\u6b62\u518d\u7528\u7121\u7dda\u5feb\u9580\u62cd\u651d,3000MM\u771f\u7684\u6643\u52d5\u5f97\u5f88\u56b4\u91cd......\u770b\u770b\u9304\u5f71\u7bc4\u4f8b...\u96a8\u4fbf\u4e00\u500b\u5fae\u98a8\u904e\u4f86\u5c31\u6643\u5230\u4e0d\u8981\u4e0d\u8981\u7684..\r\n<\/p>\r\n\r\n<div style=\"text-align: center\">\r\n    <iframe src=\"https:\/\/www.youtube.com\/embed\/UAYWyNQvZAM?si=Xh5EBFWtWwPrD2yV\" title=\"YouTube video player\"\r\n        style=\"border-style: none;\"\r\n        allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\r\n        referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen><\/iframe>\r\n<\/div>\r\n\r\n","post_index":"20240505195530.html"},{"post_category":["\u96dc\u4e03\u96dc\u516b"],"post_tags":["\u5176\u4ed6"],"post_time":"2024-05-04 20:24:40","post_title":"\u95dc\u65bc\u672cBlog\u767c\u5c55","post_content":"<p>2024-05-04 : <\/p>\r\n<p>\u5176\u5be6\u5f88\u4e45\u524d\u5c31\u6709\u60f3\u81ea\u5df1\u6253\u9020\u4e00\u500b\u7c21\u55aeblog\u7684\u60f3\u6cd5,\u4e0d\u904e\u5c31\u662f\u61f6,\u4e0d\u7136\u5f9e\u4e8b\u8cc7\u8a0a\u8edf\u9ad4\u696d\u4f86\u8aaa\u4e26\u4e0d\u662f\u4ec0\u9ebc\u554f\u984c,\u52a0\u4e0a\u672c\u4eba\u504f\u597d\u6975\u7c21\u529f\u80fd\u4e3b\u7fa9,\u6240\u4ee5\u5be6\u4f5c\u6210\u672c\u4e5f\u4e0d\u9ad8,\u4e4b\u6240\u4ee5\u6703\u60f3\u81ea\u5df1\u5be6\u4f5c\u662f\u56e0\u70ba\u81ea\u5df1\u60f3\u600e\u6a23\u8a2d\u8a08\u5c31\u600e\u6a23\u8a2d\u8a08,\u4e0d\u7528\u53d7\u9650\u5e73\u53f0\u6216\u662f\u54ea\u5957\u8edf\u9ad4,\u66f4\u6c92\u6709\u5ee3\u544a,\u800c\u4e14\u5f88\u591a\u6771\u897f\u90fd\u80fd\u6309\u7167\u81ea\u5df1\u7684\u610f\u601d\u53bb\u57f7\u884c.\r\n<\/p>\r\n<p>\u4e3b\u8981\u5e0c\u671b\u4e00\u5207\u90fd\u7c21\u7c21\u55ae\u55ae\u7684,\u7136\u5f8c\u8a2d\u8a08\u7684\u6a23\u677f\u80fd\u5920\u8f03\u70ba\u7b26\u5408\u6211\u6574\u7406\u7167\u7247\u4f7f\u7528,\u76ee\u524d\u4ecd\u7136\u5728\u958b\u767c\u4e2d,\u73fe\u968e\u6bb5\u9084\u6c92\u4e32\u4e0a\u8cc7\u6599\u5eab,\u53ea\u662f\u975c\u614b\u7db2\u9801,\u5148\u767c\u4f48\u5047\u65e5\u9577\u7126\u93e1\u628a\u73a9\u5fc3\u5f97,\u65e5\u5f8c\u518d\u6162\u6162\u628ablog\u5b8c\u6574.<\/p>","post_index":"20240504202440.html"}]}