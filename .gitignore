# Configuration files (Sensitive Data)
config.php
config.js

# Generated HTML files (Only keep the template)
/*.html
!/blog.html
!/index.html

# Generated Sitemap
/sitemap.xml

# Generated Previews
/preview/*.jpg
/preview/*.png

# Blog Pictures
/pic/

# Category data (Keep readme only)
/category/*
!/category/readme.txt

# Contents data (Keep readme only)
/contents/*
!/contents/readme.txt

# Static assets - Ignore images
/static/*.png
/static/*.jpg
/static/*.jpeg
/static/*.gif
/static/*.ico

# Minified Assets (Generated by mini.py)
*.min.js
*.min.css

# Dependencies
node_modules/

# Python
__pycache__/
*.pyc

# System files
Thumbs.db
.DS_Store

# Logs
error_log
*.log

# Test directory
test/

# IDE Settings
.vscode/
.idea/