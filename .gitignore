# Configuration files (Sensitive Data)
config.php
config.js

# Generated HTML files (Only keep the template)
/*.html
!/blog.html
!/index.html
/post/

# Generated Sitemap
/sitemap.xml

# Generated Previews
/preview/*.jpg
/preview/*.png

# Blog Pictures
/pic/

# Category data (Keep readme only)
/category/*
!/category/readme.txt

# Contents data (Keep readme only)
/contents/*
!/contents/readme.txt

# Static assets - Ignore images
/static/*.png
/static/*.jpg
/static/*.jpeg
/static/*.gif
/static/*.ico

# Minified Assets (Generated by mini.py)
*.min.js
*.min.css
!/admin/assets/**

# Dependencies
node_modules/

# Python
__pycache__/
*.pyc

# System files
Thumbs.db
.DS_Store

# Logs
error_log
*.log

# Test directory
test/

# IDE Settings
.vscode/
.idea/

# Database files
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db

# Backup artifacts
/backup/*.zip
/admin/attempts.log

# Generated JSON API data
/api/json/

# Generated Build Cache Hash
/contents/build_hash.json

# Album Service
/album/config.php
/album/config.js
/album/shorturl.txt
/album/album.html
/album/view/
/album/Collection/**/*.jpg
/album/Collection/**/Thumbnail/
/album/static/*_example.html
!/album/static/
!/album/static/**/*.gif
!/album/static/**/*.jpg
!/album/static/**/*.png
!/album/static/**/*.js
!/album/static/**/*.css